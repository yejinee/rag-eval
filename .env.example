# ── 골든셋 평가 (eval/) ──
# 이 파일을 .env 로 복사해 값을 채운다. (.env 는 git 제외)
# 같은 이름의 OS 환경변수가 있으면 그 값이 .env 보다 우선한다.

# 평가 대상 RAG API (POST {EVAL_API_URL}/query/sync 를 호출)
EVAL_API_URL=http://localhost:8000
EVAL_API_CONCURRENCY=2
EVAL_API_TIMEOUT_SECONDS=120
EVAL_HIT_K=3,5

# true = LLM 채점 지표 추가 (CLI --llm / --no-llm 이 우선)
EVAL_USE_LLM=false

# 채점용 LLM(Judge) — EVAL_USE_LLM=true 일 때만 사용. OpenAI 호환 서버
# LLM ON 인데 BASE_URL / MODEL 이 비어 있으면 API 호출 전에 중단한다
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_TEMPERATURE=0
EVAL_JUDGE_CONCURRENCY=2
EVAL_JUDGE_TIMEOUT_SECONDS=180
